# Threads Comment Video Studio Environment Configuration

# Server
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000
DEBUG=true

# Database & Storage
DATABASE_URL=sqlite:///./data/studio.db
DATA_DIR=./data
CACHE_DIR=./data/cache

# TTS Configuration
DEFAULT_TTS_PROVIDER=edge_tts
# Optional FPT.AI Speech API Key (https://fpt.ai)
FPTAI_API_KEY=
# Optional Google Cloud Text-to-Speech credentials file
GOOGLE_APPLICATION_CREDENTIALS=

# CapCut Desktop Configuration
# Auto-detected on Windows if omitted
CAPCUT_DRAFT_FOLDER=%LOCALAPPDATA%\CapCut\User Data\Projects\com.lveditor.draft

# Meta Threads API & Discovery (Optional for discovery & official crawling)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
VIETNAM_TRENDS_FEED_URL=https://trends.google.com/trending/rss?geo=VN

# Social Media Publishing Credentials (Optional - configured via UI)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
